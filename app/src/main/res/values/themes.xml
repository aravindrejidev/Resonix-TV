<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colour = app background, so there is no white flash while the app starts. -->
    <style name="Theme.ResonixTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/resonix_background</item>
        <item name="android:colorBackground">@color/resonix_background</item>
        <item name="android:statusBarColor">@color/resonix_background</item>
        <item name="android:navigationBarColor">@color/resonix_background</item>
    </style>
</resources>
